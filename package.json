{
    "name": "@fraczak/k",
    "version": "6.4.0",
    "description": "k — a language for composing first-order partial functions over algebraic data types (products and tagged unions); includes runtime, type derivation, REPL, and codec toolchain",
    "main": "index.mjs",
    "exports": {
        ".": "./index.mjs",
        "./*": "./*"
    },
    "scripts": {
        "prepare": "jiwson -m es6 parser.jison -o parser.mjs; jiwson -m es6 valueParser.jison -o valueParser.mjs; ",
        "test": "node scripts/run-tests.mjs",
        "test:backends": "node backends/llvm/scripts/run-tests.mjs && node backends/wasm/scripts/run-tests.mjs",
        "test:llvm": "node backends/llvm/scripts/run-tests.mjs",
        "test:wasm": "node backends/wasm/scripts/run-tests.mjs",
        "test:arm64": "node backends/arm64/scripts/run-tests.mjs",
        "conformance": "node conformance/run.mjs",
        "benchmark": "node scripts/benchmark.mjs",
        "benchmark:html": "node scripts/render-benchmark.mjs",
        "perf:ieee": "node scripts/perf-ieee.mjs",
        "perf:ieee:full": "node scripts/perf-ieee.mjs --full",
        "perf:int": "node scripts/perf-int.mjs",
        "perf:poly": "node scripts/perf-poly.mjs",
        "perf:poly:trace": "node scripts/perf-poly.mjs --trace",
        "perf:idempotency": "node scripts/benchmark-idempotency.mjs",
        "deps:graph": "node scripts/generate-dependency-graph.mjs",
        "compare": "node harness/cli.mjs",
        "build:repl-html": "node scripts/build-repl-html.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/fraczak/k.git"
    },
    "author": "Wojciech Fraczak",
    "license": "ISC",
    "bin": {
        "k": "./k.mjs",
        "k-compile": "./objects/compile.mjs",
        "k-decompile": "./objects/decompile.mjs",
        "k-extract-aliases": "./objects/extract-aliases.mjs",
        "k-inspect-object": "./objects/inspect.mjs",
        "k-validate-object": "./objects/validate.mjs",
        "k-kir": "./kir.mjs",
        "k-llvm-build": "./backends/llvm/bin/k-llvm-build.mjs",
        "k-llvm-compile": "./backends/llvm/bin/k-llvm-compile.mjs",
        "k-llvm-jit": "./backends/llvm/bin/k-llvm-jit.mjs",
        "k-llvm-run": "./backends/llvm/bin/k-llvm-run.mjs",
        "k-arm64": "./backends/arm64/bin/k-arm64.mjs",
        "k-arm64-compile": "./backends/arm64/bin/k-arm64-compile.mjs",
        "k-arm64-run": "./backends/arm64/bin/k-arm64-run.mjs",
        "k-wasm": "./backends/wasm/bin/k-wasm.mjs",
        "k-wasm-compile": "./backends/wasm/bin/k-wasm-compile.mjs",
        "k-wasm-run": "./backends/wasm/bin/k-wasm-run.mjs",
        "k-ieee": "./codecs/ieee.mjs",
        "k-int": "./codecs/int.mjs",
        "k-json": "./codecs/json.mjs",
        "k-parse": "./codecs/k-parse.mjs",
        "k-print": "./codecs/k-print.mjs",
        "k-repl": "./repl.mjs",
        "k-show": "./codecs/show.mjs",
        "k-unit": "./codecs/unit.mjs",
        "k-utf16": "./codecs/utf16.mjs",
        "k-utf8": "./codecs/utf8.mjs",
        "k-vm": "./kvm.mjs"
    },
    "dependencies": {
        "wabt": "^1.0.39"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "jiwson": "^0.1.2"
    }
}
